# ==========================================
# 考勤模块 Web 化 —— 环境变量模板
# 复制为 .env 后按实际环境填写；.env 禁止进版本库与镜像
# ==========================================

# ── Django ──
# 生成方式：python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── 数据库 ──
# 端口与生产数据系统（3308）刻意错开，便于同机共存
DB_NAME=attendance_db
DB_USER=att_admin
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3309

# ── 部署路径前缀（Nginx 反向代理多项目共存） ──
# 留空表示部署在根路径
FORCE_SCRIPT_NAME=
STATIC_URL=/static/
MEDIA_URL=/media/
CSRF_TRUSTED_ORIGINS=

# ── 上传限制 ──
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=xlsx
