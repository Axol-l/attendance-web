# ==========================================
# 考勤模块 Web 化 —— 生产环境变量模板
# ==========================================

SECRET_KEY=CHANGE-ME-TO-A-RANDOM-50-CHAR-STRING
DEBUG=False
ALLOWED_HOSTS=your-server-ip,your-domain.com

DB_NAME=attendance_db
DB_USER=att_admin
DB_PASSWORD=CHANGE-ME
DB_HOST=db
DB_PORT=3306

# ⚠️ 必填：docker-compose.server.yml 的 MySQL 容器（MYSQL_ROOT_PASSWORD）与它的
#    healthcheck 都引用这个变量，且都没写默认值。缺了会导致 db 容器起不来，
#    或 healthcheck 永远失败、web 因 depends_on 一直不启动。
DB_ROOT_PASSWORD=CHANGE-ME-TOO

# 路径前缀方式接入共享 Nginx
FORCE_SCRIPT_NAME=/attendance
STATIC_URL=/attendance/static/
MEDIA_URL=/attendance/media/
CSRF_TRUSTED_ORIGINS=http://your-server-ip

# 备份目录（与 docker-compose.server.yml 的挂载点对齐）
BACKUP_DIR=/app/backup_files

# 上传与导入上限
MAX_FILE_SIZE=52428800
IMPORT_MAX_ROWS=100000

# 查询上限
QUERY_MAX_RESULTS=2000
QUERY_PAGE_SIZE=100
